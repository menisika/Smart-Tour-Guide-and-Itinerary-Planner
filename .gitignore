# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Expo. The native projects are generated from app.json by `expo prebuild`
# and are never edited by hand.
.expo/
expo-env.d.ts
apps/mobile/android/
apps/mobile/ios/

# Local settings; `.env.example` files are kept
.env
.env.*
!.env.example

# Terraform: the lock file is kept, the working directory and state are not
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars

# The spike is measurement code, not part of the workspace: its code and its
# README are kept; its downloads, outputs and dependencies are not.
spikes/*/data/
spikes/*/out/
spikes/*/node_modules/

# Worktrees of Claude sessions: whole copies of the repository on other
# branches, inside the checkout. Prettier reads this file, so `pnpm lint`
# stays out of them as well.
.claude/worktrees/

# Editors and operating systems
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
