{
  "version": 8,
  "name": "Promenade, sun",
  "metadata": {
    "promenade:about": "Generated by design/tools/build-system.mjs from design/system/tokens.json. Do not edit.",
    "promenade:theme": "sun",
    "promenade:schema": "Protomaps basemap, version 4",
    "promenade:language": "Names are written with name:en. The map component puts the language of the person in its place; where OpenStreetMap has no name in that language the local name is shown (ADR-0008, point 5).",
    "promenade:name-layers": [
      "street-names"
    ],
    "promenade:camera": {
      "plan": {
        "pitch": 0,
        "use": "The Route before the start: seen from above, north up"
      },
      "walk": {
        "pitch": 52,
        "zoom": 17.2,
        "use": "The Outing: seen at an angle, the direction of travel up, buildings standing"
      },
      "saver": {
        "pitch": 0,
        "zoom": 16.6,
        "use": "The Outing in the saver mode: flat, heading up, nothing extruded, no blur, nothing in motion"
      }
    },
    "promenade:walking": "With the walking camera the application shows buildings-standing and hides buildings; in the saver mode it does neither.",
    "promenade:haze": "The haze at the horizon is drawn by the application over the map: MapLibre Native has no sky."
  },
  "glyphs": "glyphs/{fontstack}/{range}.pbf",
