{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Workspace packages are type-checked from their sources, which import
    // each other with the `.ts` extension.
    "customConditions": ["@promenade/source", "react-native"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "expo-env.d.ts", ".expo/types/**/*.ts"]
}
