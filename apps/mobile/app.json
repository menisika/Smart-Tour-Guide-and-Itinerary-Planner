{
  "expo": {
    "name": "Promenade",
    "slug": "promenade",
    "version": "0.0.0",
    "scheme": "promenade",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "bundleIdentifier": "com.menisika.promenade"
    },
    "android": {
      "package": "com.menisika.promenade"
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-dev-client"]
  }
}
