{
  "name": "@promenade/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "The Expo application: iOS, Android, and the public web (ADR-0005, ADR-0007).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/mark-server-build.mjs",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android:dev": "pnpm prebuild:android && cd android && ./gradlew assembleDebug",
    "build:ios:dev": "expo run:ios --device",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@promenade/i18n": "workspace:*",
    "expo": "58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "~19.3.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3"
  }
}
