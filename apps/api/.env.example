# Settings for running the API from sources against the services of
# `docker compose up`. Copy to `.env`; `pnpm dev:api` reads it if it exists.
# These are local values only. No secret belongs in this file.
PORT=8080
DATABASE_URL=postgres://promenade:promenade@localhost:5433/promenade
LANGUAGE_MODEL_ADAPTER=replay
SPEECH_SYNTHESIS_ADAPTER=replay
SPEECH_RECOGNITION_ADAPTER=replay
# The object storage of the compose environment (docker/object-storage/s3.json).
OBJECT_STORE_ENDPOINT=http://localhost:8333
OBJECT_STORE_REGION=auto
OBJECT_STORE_ACCESS_KEY_ID=promenade-local
OBJECT_STORE_SECRET_ACCESS_KEY=promenade-local-secret
OBJECT_STORE_PUBLIC_BUCKET=promenade-public
OBJECT_STORE_PRIVATE_BUCKET=promenade-private
OBJECT_STORE_PUBLIC_BASE_URL=http://localhost:8333/promenade-public
