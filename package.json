{
  "name": "promenade",
  "version": "0.0.0",
  "private": true,
  "description": "Promenade (working name): a city outing planner. Monorepo root.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "lint": "pnpm lint:eslint && pnpm lint:boundaries && pnpm lint:types && pnpm lint:plan && pnpm lint:format",
    "lint:eslint": "eslint .",
    "lint:boundaries": "depcruise apps packages tools --config .dependency-cruiser.cjs",
    "lint:types": "tsc --noEmit -p tsconfig.json && pnpm -r --no-bail=false run typecheck",
    "lint:plan": "node scripts/check-work-plan.mjs",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "plan:update": "node scripts/check-work-plan.mjs --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:packages": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "dev:api": "pnpm --filter @promenade/api dev",
    "dev:console": "pnpm --filter @promenade/console dev",
    "dev:mobile": "pnpm --filter @promenade/mobile start",
    "up": "docker compose up --build --wait",
    "down": "docker compose down",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "catalog:",
    "@promenade/eslint-plugin": "workspace:*",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
