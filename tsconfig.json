{
  // Type-checks the configuration files that live outside any package.
  // Each package has its own `tsconfig.json` for its sources and tests.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vitest.config.ts", "apps/api/vitest.config.ts", "scripts/**/*.mjs"],
  "exclude": ["**/node_modules", "**/dist"]
}
